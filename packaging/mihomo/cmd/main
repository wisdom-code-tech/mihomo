#!/bin/bash

LOG_FILE="${TRIM_PKGVAR}/manager.log"
PID_FILE="${TRIM_PKGVAR}/manager.pid"
SOCKET_FILE="${TRIM_APPDEST}/mihomo.sock"
MANAGER="${TRIM_APPDEST}/bin/mihomo-manager"
CORE="${TRIM_APPDEST}/bin/mihomo"

write_error() {
  if [ -n "${TRIM_TEMP_LOGFILE:-}" ]; then
    printf '%s\n' "$1" > "${TRIM_TEMP_LOGFILE}"
  fi
  printf '%s\n' "$1" >> "${LOG_FILE}"
}

is_running() {
  [ -r "${PID_FILE}" ] || return 1
  pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
  [ -n "${pid}" ] && kill -0 "${pid}" 2>/dev/null
}

start_service() {
  if is_running; then
    return 0
  fi
  mkdir -p "${TRIM_PKGVAR}"
  rm -f "${PID_FILE}" "${SOCKET_FILE}"
  if [ ! -x "${MANAGER}" ] || [ ! -x "${CORE}" ]; then
    write_error "Mihomo 可执行文件缺失或不可执行。"
    return 1
  fi
  "${MANAGER}" \
    -mihomo "${CORE}" \
    -config-dir "${TRIM_PKGVAR}" \
    -socket "${SOCKET_FILE}" \
    -log "${TRIM_PKGVAR}/mihomo.log" >> "${LOG_FILE}" 2>&1 &
  pid=$!
  printf '%s' "${pid}" > "${PID_FILE}"
  count=0
  while [ "${count}" -lt 20 ]; do
    if ! kill -0 "${pid}" 2>/dev/null; then
      rm -f "${PID_FILE}"
      write_error "Mihomo 管理进程启动失败，请查看 manager.log。"
      return 1
    fi
    [ -S "${SOCKET_FILE}" ] && return 0
    sleep 1
    count=$((count + 1))
  done
  kill -TERM "${pid}" 2>/dev/null || true
  rm -f "${PID_FILE}"
  write_error "等待 fnOS 网关 Socket 超时。"
  return 1
}

stop_service() {
  if ! is_running; then
    rm -f "${PID_FILE}" "${SOCKET_FILE}"
    return 0
  fi
  pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
  kill -TERM "${pid}" 2>/dev/null || true
  count=0
  while kill -0 "${pid}" 2>/dev/null && [ "${count}" -lt 12 ]; do
    sleep 1
    count=$((count + 1))
  done
  if kill -0 "${pid}" 2>/dev/null; then
    kill -KILL "${pid}" 2>/dev/null || true
  fi
  rm -f "${PID_FILE}" "${SOCKET_FILE}"
}

case "${1:-}" in
  start) start_service ;;
  stop) stop_service ;;
  status) if is_running && [ -S "${SOCKET_FILE}" ]; then exit 0; else exit 3; fi ;;
  *) exit 1 ;;
esac
